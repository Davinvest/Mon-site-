# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://comptoirlegal.fr

# Connecteur de publication : "local" (par défaut) ou "lgdf" (API de Jordan, quand la clé sera fournie)
CONNECTEUR=local
LGDF_API_URL=
LGDF_API_KEY=

# Journal partenaire habilité (affiché au client en mode local)
JOURNAL_PARTENAIRE_NOM=

# Stripe — laisser vide pour le mode démonstration (aucun paiement réel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (SMTP OVH Zimbra : ssl0.ovh.net, port 465)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Comptoir Légal <contact@comptoirlegal.fr>"
MAIL_COMMANDES=commandes@comptoirlegal.fr
